# --- Project data ---
# Ignore park shapefiles, RIP PDFs, GDB exports, test data by default (large /
# regenerate locally with tools/). BUT keep the public NPS RIP route tables +
# scope tables so the app runs on a fresh clone.
data/*
!data/_rip/
data/_rip/*
!data/_rip/route_ids.json
!data/_rip/scope.json

# NPS RIP Cycle 6 per-park bundles (tools/nps_rip_slice.py). Public government
# data, so all 342 parks ship with the app and import straight from the
# deployed site. Committed GZIPPED (277 MB raw -> 49 MB gz) and decompressed in
# the browser via DecompressionStream. The raw .json stay local (regenerate
# with tools/nps_rip_slice.py) so git only tracks the .gz + index.
!data/rip/
data/rip/*
!data/rip/parks_index.json
!data/rip/*.json.gz

# --- Reference material (large; donor RoadWalk source + stashed skeleton) ---
reference/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
