# --- Project data ---
# Ignore park shapefiles, RIP PDFs, GDB exports, test data by default (large /
# regenerate locally with tools/). BUT keep the public NPS RIP route tables +
# scope tables so the app runs on a fresh clone.
data/*
!data/_rip/
data/_rip/*
!data/_rip/route_ids.json
!data/_rip/scope.json

# NPS RIP Cycle 6 per-park bundles (tools/nps_rip_slice.py). This is public
# government data, so sample parks ship with the app and File > RIP Cycle 6
# can import them straight from the deployed site. Slicing all 309 parks is
# ~200 MB, so keep the full set local and commit only what's worth shipping.
!data/rip/
data/rip/*
!data/rip/parks_index.json
!data/rip/NPS_C6_MORR.json
!data/rip/NPS_C6_SHEN.json
!data/rip/NPS_C6_GRSM.json

# --- Reference material (large; donor RoadWalk source + stashed skeleton) ---
reference/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
